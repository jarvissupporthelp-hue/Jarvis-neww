# Use the matching project values for each environment.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only invitation delivery configuration.
SUPABASE_SECRET_KEY=
JARVIS_AUTH_ORIGIN=

# Server-only connection for the hackathon foundation schema.
DATABASE_URL=
# Local demo seed only. Set a private value of at least 12 characters.
JARVIS_DEMO_PASSWORD=
# Optional gateway credentials. Hosted Vercel deployments use OIDC by default.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=nvidia/nemotron-3.5-lightning-free

# Optional OpenAI-compatible free-tier provider. Set all three to override the gateway.
FREE_LLM_BASE_URL=
FREE_LLM_API_KEY=
FREE_LLM_MODEL=
# Optional Chroma Cloud retrieval. Keep these server-side; set all values to enable.
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
# OpenAI-compatible embeddings endpoint; use the same model for indexing and questions.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Optional Campus Resources settings.
CAMPUS_MAX_ACTIVE_BOOKINGS=2
CAMPUS_MAX_BOOKING_MINUTES=180
# Auth UUID of the student whose timetable Academics currently serves.
CAMPUS_DEMO_STUDENT_USER_ID=

# Optional Career settings.
CAREER_DEMO_STUDENT_USER_ID=
CAREER_MENTOR_ACCOUNTS=
