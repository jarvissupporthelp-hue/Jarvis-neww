{
  "name": "jarvis",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/foundation-migrate.mjs",
    "db:seed": "node --experimental-transform-types scripts/foundation-seed.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node --test tests/e2e/*.test.mjs",
    "test:roles": "node scripts/test-roles.mjs",
    "test:db": "bash scripts/test-database.sh",
    "prebuild": "npm run db:generate",
    "pretypecheck": "npm run db:generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@supabase/supabase-js": "2.90.1",
    "chromadb": "3.5.0",
    "next": "^16.4.6",
    "pg": "8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "unpdf": "2.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": "24.x"
  }
}
